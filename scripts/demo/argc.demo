# argc: a script declares its arguments in comments, and the shell parses them.
#
# The fixture writes the two scripts this and `argc-eval.demo` use, into `$WORK/bin`.
cols 100
rows 24
speed 0.05

# **`$PATH` is set here rather than around the shell**, because a config rebuilds it at startup and
# whatever the launcher exported is gone by the first prompt. `bin` holds the two scripts the
# fixture wrote; `$OSLO_DIR` is the binary being recorded, which is the one a `#!/usr/bin/env oslo`
# script has to find.
run export PATH=/tmp/oslo-demo-work/bin:$OSLO_DIR:$PATH
wait 0.8
clear

# The whole script. Nine lines, five of them comments — and no `eval` at the end, because oslo has
# the parser linked in.
run bat --style=numbers --paging=never $(which deploy)
wait 4.0

clear

# The help is generated from those comments.
run deploy --help
wait 4.0

clear

# **And so is the completion.** Nothing was installed, nothing was generated: the dropdown is
# reading the same comments.
type deploy --
wait 1.0
key Tab
wait 3.5
key Escape
wait 0.5
# **`C-c`, not `C-u`.** Escape closes the dropdown and leaves the words on the line; a kill-line
# after it left `deploy --env` behind once, and the next command typed into the leftovers.
key C-c
wait 1.0


# And then it just runs.
run deploy --dry-run --tries 2 --env prod app-1.4
wait 2.5

# A mistake is the script's own, reported before its body ever runs.
run deploy --nonsense
wait 2.5
