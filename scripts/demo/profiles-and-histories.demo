# Profiles: one shell, several histories. $OSLO_PROFILE names the database file.
#
# **Off camera**: a config rebuilds `$PATH` at startup, so what the launcher exported is gone by the
# first prompt — and `oslo profile …` is a *program*, which would otherwise be whichever oslo is
# installed rather than the one being demonstrated. The stand-in for ssh inherits this too, so the
# far end runs the same binary.
setup export PATH=$OSLO_DIR:/tmp/oslo-demo-work/bin:$PATH
cols 120
rows 20
speed 0.055

run oslo history path
wait 1.2
run grep -c fn src/lib.rs
wait 1.0

# An agent's shell. The variable is inherited by everything it spawns.
#
# **oslo asks first.** A shell inside a shell looks exactly like the one you were in, so the only
# sign is an `exit` later that does not close the terminal — and Enter alone answers "stay here".
# This one is meant, so: y, then Enter.
run OSLO_PROFILE=agent oslo
wait 1.6
key y
wait 1.0
key Enter
wait 1.0
run oslo history path
wait 1.6
run grep -c fn src/parser.rs
wait 1.2
run exit
wait 1.5
clear

# Back in my own history: the same question, asked of one store and then the next.
type grep -c
wait 0.6
key C-r
wait 2.4
key Tab
wait 2.8
key Escape
wait 1.0
# The prompt comes back with the line as it was; clear it so the shell is left empty.
key C-u
wait 0.4
clear

# **And the same profile on two machines.** There is no second computer in a recording, so two
# fixture homes under /tmp stand in for them — never this machine's own history, see `fixture.sh`.
# Both stand-ins are on screen before they are used: `here` is the near machine and `pretend-ssh` is
# the far one, and neither is oslo. Everything between them is.
wait 1.2
run cat /tmp/oslo-demo-work/bin/here
wait 2.6
run cat /tmp/oslo-demo-work/bin/pretend-ssh
wait 3.0
clear

# What that machine holds, and the fingerprint that says which profile it is.
run here oslo profile
wait 2.6
run here oslo history list -n 5
wait 3.0
clear

# Two-way, and it says what moved in each direction.
#
# **The long waits are not for the reader.** A sync forks the far end twice and merges two stores;
# typing the next line before that is done puts half of it into a shell that is still busy, and the
# other half becomes a command of its own.
run here OSLO_SSH=/tmp/oslo-demo-work/bin/pretend-ssh oslo profile sync laptop
wait 5.0

# Both machines now hold both histories — and `cargo build --release`, run on each, is *two* events
# rather than one overwriting the other, because every event carries the host that ran it.
run here oslo history list -n 8
wait 4.0
clear

# Running it again moves nothing, which is what makes it safe in a login file.
run here OSLO_SSH=/tmp/oslo-demo-work/bin/pretend-ssh oslo profile sync laptop
wait 5.0
