# secrets: a value kept encrypted, handed out when something asks — and the crypto itself replaceable.
#
# Against the fixture's own store and key, so nothing here is anybody's real token: `fixture.sh`
# writes `gh-token` and the `GITHUB_TOKEN` variable that fetches it.
env XDG_DATA_HOME=/tmp/oslo-demo-work/data
# The key is not in the store. Two directories, opposite rules — the recording shows both.
env XDG_STATE_HOME=/tmp/oslo-demo-work-key
# **Off camera**, and not `env`: a config rebuilds `$PATH` at startup, so what the launcher exported
# is gone by the first prompt — and `oslo secret …` is a *program*, which would then be whichever
# oslo is installed rather than the one being demonstrated. `$WORK/bin` is on it for the stand-in
# the last act uses.
setup export PATH=$OSLO_DIR:/tmp/oslo-demo-work/bin:$PATH
cols 120
rows 22
speed 0.06

# Keeping one. The value comes in on standard input, so it is never a command-line argument that a
# history file or a process list could hold.
run printf %s 'demo-not-a-real-stripe-key' | oslo secret set stripe
wait 1.2

# What is on disk is a sealed file, and not the value: a header, a random nonce, a tag.
run head -c 48 $XDG_DATA_HOME/oslo/secrets/stripe.sealed | od -c | head -3
wait 2.6
clear

# Where the two halves live, and which of them may be committed.
run oslo secret where
wait 2.2
clear

# Getting one back. One value, one child, and no shell in between holding a copy — printed rather
# than sent, because a recording that needed the network would be a recording of the network.
run oslo secret get stripe
wait 1.4
run oslo secret run TOKEN=gh-token -- sh -c 'printf "Authorization: Bearer %s\n" "$TOKEN"'
wait 2.0
clear

# A second store, with a directory and a key of its own.
run oslo secret --store work key add file /tmp/oslo-demo-work-key/work-key
wait 1.0
run oslo secret --store work key init
wait 1.4
# A key can also be a *program*, for one oslo cannot compute itself — a password manager, a
# smartcard. File keys are tried first, so this is never run while the one above opens the file:
# `pass` is not even installed on the machine that recorded this, and nothing here fails.
run oslo secret --store work key add command -- pass show oslo/key
wait 1.2
run oslo secret --store work key list
wait 2.4
run printf %s 'the-deploy-key' | oslo secret --store work set deploy
wait 1.0
run oslo secret --store work get deploy
wait 1.7
clear

# All of it is one flat file beside the key — because `oslo secret get` is a child process that
# never reads config.lua, and configuration that only existed after Lua had run would apply here and
# silently not in cron.
run cat /tmp/oslo-demo-work-key/oslo/secrets.conf
wait 2.7
clear

# The half that makes it a shell feature: a stored *variable* whose body is the recipe. Nothing has
# run yet — the token is fetched by the first thing that reads the name, once, in this shell.
run oslo macros show --plain | grep GITHUB
wait 1.8
run echo "$GITHUB_TOKEN"
wait 1.8
clear

# **And the crypto itself is replaceable** — that is what makes `age`, `gpg` or a TPM reachable
# without oslo carrying any of them. This stands in for one: neither `age` nor a YubiKey is on the
# machine that recorded this, so what is shown is the contract oslo relies on — bytes in, bytes out,
# and a prompt on standard error the way a hardware key asks for a touch.
run cat /tmp/oslo-demo-work/bin/pretend-age
wait 2.5

# A store says which mechanism opens it. `crypto hook` means Lua does.
run printf '\n[yubi]\ncrypto hook\n' >> /tmp/oslo-demo-work-key/oslo/secrets.conf
wait 1.0
# So a process that never read your config says so, instead of quietly doing something else.
run oslo secret --store yubi get deploy
wait 2.4
clear

# In a shell that *did* read it, two handlers claim that one store. `=` runs one Lua line at the
# shell prompt.
run =function yubi(f) return function(s,n,b) if s=="yubi" then return oslo.secret.through({"pretend-age",f},b) end end end
wait 1.4
run =oslo.on["on-secret-encrypt"](yubi("-e")) oslo.on["on-secret-decrypt"](yubi("-d"))
wait 1.4
run =local v = oslo.secret.open("yubi") v:set("deploy", "held-in-the-device") print(v:get("deploy"))
wait 2.2

# What landed on disk is that program's format, not oslo's. oslo kept the store, the name and the
# file; it did none of the crypto.
run head -2 $XDG_DATA_HOME/oslo/stores/yubi/deploy.sealed
wait 2.2
