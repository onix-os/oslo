# secrets: a value kept encrypted, handed out when something asks — and the variable that asks.
#
# Against the fixture's own store and key, so nothing here is anybody's real token: `fixture.sh`
# writes `gh-token` and the `GITHUB_TOKEN` variable that fetches it.
env XDG_DATA_HOME=/tmp/oslo-demo-work/data
# The key is not in the store. Two directories, opposite rules — the recording shows both.
env XDG_STATE_HOME=/tmp/oslo-demo-work-key
# **Off camera**, and not `env`: a config rebuilds `$PATH` at startup, so what the launcher exported
# is gone by the first prompt — and `oslo secret …` is a *program*, which would then be whichever
# oslo is installed rather than the one being demonstrated.
setup export PATH=$OSLO_DIR:$PATH
cols 100
rows 22
speed 0.06

# Keeping one. The value comes in on standard input, so it is never a command-line argument that a
# history file or a process list could hold.
run printf %s 'demo-not-a-real-stripe-key' | oslo secret set stripe
wait 1.6
run oslo secret list
wait 2.0

# What is on disk is the age format, and not the value.
run head -3 $XDG_DATA_HOME/oslo/secrets/stripe.age
wait 3.0
clear

# Where the two halves live, and which of them may be committed.
run oslo secret where
wait 3.4
clear

# Getting one back. `$(oslo secret get …)` is the shape a script wants.
run oslo secret get stripe
wait 2.2
# One value, one child, and no shell in between holding a copy — printed rather than sent, because a
# recording that needed the network would be a recording of the network.
run oslo secret run TOKEN=gh-token -- sh -c 'printf "Authorization: Bearer %s\n" "$TOKEN"'
wait 2.8
clear

# A second store, with a directory of its own — this one is meant to be committed.
run oslo secret --store work key add file /tmp/oslo-demo-work-key/work-identity
wait 1.4
run oslo secret --store work key init
wait 2.0
# And a key that is a *program*, for one oslo cannot compute itself: a password manager, a
# smartcard, anything that prints an identity. Native keys are tried first, so this runs only when
# they do not open the file.
run oslo secret --store work key add command -- pass show oslo/age-identity
wait 2.2
run oslo secret --store work key list
wait 3.0
clear

# Who a store encrypts to. Adding one does not re-encrypt what is already there; `rotate` is the
# separate, deliberate step that does.
run oslo secret --store work recipient add age1lggyhqrw2nlhcxprm67z43rta597azn8gknawjehu9d9dl0jq3yqqvfafg
wait 1.8
run oslo secret --store work recipient
wait 2.6
run printf %s 'the-deploy-key' | oslo secret --store work set deploy
wait 1.4
run oslo secret --store work rotate
wait 2.4
clear

# All of it is one flat file beside the key — because `oslo secret get` is a child process that
# never reads config.lua, and configuration that only existed after Lua had run would apply here and
# silently not in cron.
run cat /tmp/oslo-demo-work-key/oslo/secrets.conf
wait 4.0
clear

# And the half that makes it a shell feature: a stored *variable* whose body is the recipe.
run oslo macros show --plain
wait 2.6

# Nothing has run yet. The token is fetched by the first thing that reads the name — once, in this
# shell — and is an ordinary exported variable from then on.
run echo "$GITHUB_TOKEN"
wait 2.6
run echo "$GITHUB_TOKEN"
wait 2.4
