# secrets: a value kept encrypted, handed out when something asks — and the variable that asks.
#
# Against the fixture's own store and key, so nothing here is anybody's real token: `fixture.sh`
# writes `gh-token` and the `GITHUB_TOKEN` variable that fetches it.
env XDG_DATA_HOME=/tmp/oslo-demo-work/data
# The key is not in the store. Two directories, opposite rules — the recording shows both.
env XDG_STATE_HOME=/tmp/oslo-demo-work-key
env PATH=$OSLO_DIR:$PATH
cols 100
rows 22
speed 0.06

# Keeping one. The value comes in on standard input, so it is never a command-line argument that a
# history file or a process list could hold.
run printf %s 'demo-not-a-real-stripe-key' | oslo secret set stripe
wait 1.6
run oslo secret list
wait 2.0

# What is on disk is the age format, and not the value.
run head -3 $XDG_DATA_HOME/oslo/secrets/stripe.age
wait 3.0
clear

# Where the two halves live, and which of them may be committed.
run oslo secret where
wait 3.4
clear

# Getting one back. `$(oslo secret get …)` is the shape a script wants.
run oslo secret get stripe
wait 2.2
# The shape a script wants — printed rather than sent, because a recording that needed the network
# would be a recording of the network.
run printf 'Authorization: Bearer %s\n' "$(oslo secret get gh-token)"
wait 2.6
clear

# And the half that makes it a shell feature: a stored *variable* whose body is the recipe.
run oslo macros show --plain
wait 2.6

# Nothing has run yet. The token is fetched by the first thing that reads the name — once, in this
# shell — and is an ordinary exported variable from then on.
run echo "$GITHUB_TOKEN"
wait 2.6
run echo "$GITHUB_TOKEN"
wait 2.4
