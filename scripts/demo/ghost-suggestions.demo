# Ghost suggestions: the grey text past the cursor is the rest of the line, one keystroke away.
cols 120
rows 20
speed 0.08

run grep -rn fn src/config.rs
wait 1.0

# Type the start of it again and the rest is already there, in grey. Right takes the whole tail.
type grep -rn f
wait 2.4
key Right
wait 1.4
key Enter
wait 1.8

# Not only for the command: the argument gets one too, read out of the directory you are naming.
type wc -l src/pa
wait 2.4

# The ghost only exists at the end of the line: step back and it is gone, come back and it returns.
key Left
wait 1.8
key End
wait 1.6
key Right
wait 1.0
key Enter
wait 1.8
